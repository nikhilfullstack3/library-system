{
  "family": "library-system-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/library-system-task-role",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/library-system-execution-role",
  "containerDefinitions": [
    {
      "name": "library-system-backend",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "5001" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "S3_REGION", "value": "us-east-1" },
        { "name": "RATE_LIMIT_PER_MINUTE", "value": "600" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/library-system/prod/MONGODB_URI"
        },
        {
          "name": "SESSION_SECRET",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/library-system/prod/SESSION_SECRET"
        },
        {
          "name": "QR_SECRET",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/library-system/prod/QR_SECRET"
        },
        {
          "name": "S3_BUCKET_NAME",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/library-system/prod/S3_BUCKET_NAME"
        },
        {
          "name": "S3_PUBLIC_BASE_URL",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/library-system/prod/S3_PUBLIC_BASE_URL"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:5001/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/library-system",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
