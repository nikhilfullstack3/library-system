PORT=5001
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/library-system
SESSION_SECRET=change-this-to-64-random-chars
QR_SECRET=change-this-to-32-random-chars
RATE_LIMIT_PER_MINUTE=600
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://app.yourdomain.com
# Gmail SMTP for welcome emails (use an App Password, not your Gmail password)
MAIL_USER=you@gmail.com
MAIL_PASS=your-gmail-app-password
